{
  "name": "dsh-plugin-mcp-codegraph",
  "version": "0.1.0",
  "description": "Mount CodeGraph (codegraph serve --mcp) as an MCP server in DeepSeek Harness, so sessions can query code structure / symbols / call paths through mcp__codegraph__* tools.",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "config.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check index.mjs && node --check config.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.6 <0.2.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "mcp",
    "codegraph",
    "code-intelligence"
  ],
  "license": "MIT"
}
